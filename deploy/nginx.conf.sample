# Sample Nginx server block for the Azure VM deployment.
# Copy to /etc/nginx/sites-available/sael-web and adjust paths and certificates.
#
# Next.js does not compress responses in standalone mode and does not set
# long-lived cache headers on its own static output — both are handled here.

upstream sael_web {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    server_name www.sael.co sael.co;
    return 301 https://www.sael.co$request_uri;
}

server {
    listen 443 ssl http2;
    server_name www.sael.co;

    ssl_certificate     /etc/ssl/certs/sael.crt;
    ssl_certificate_key /etc/ssl/private/sael.key;

    # Compression — Next serves uncompressed in standalone mode.
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json
               image/svg+xml application/rss+xml;

    client_max_body_size 4m;

    # Immutable build output: content-hashed, safe to cache for a year.
    location /_next/static/ {
        proxy_pass http://sael_web;
        proxy_cache_valid 200 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Optimised images are cached on disk by Next; let it own the headers.
    location /_next/image {
        proxy_pass http://sael_web;
    }

    location / {
        proxy_pass http://sael_web;
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Process manager / load balancer probe.
    location = /api/health/ {
        proxy_pass http://sael_web;
        access_log off;
    }
}
